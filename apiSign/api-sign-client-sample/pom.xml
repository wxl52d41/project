<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wxl52d41</groupId>
        <artifactId>api-sign-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>api-sign-client-sample</artifactId>
    <name>api-sign-client-sample</name>
    <description>第三方客户端示例：演示如何加签调用我方接口（只依赖 api-sign-core）</description>

    <properties>
        <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
    </properties>

    <dependencies>
        <!--
            关键：第三方只需要 core，不需要 starter（starter 是给被调用方用的）
        -->
        <dependency>
            <groupId>com.wxl52d41</groupId>
            <artifactId>api-sign-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
